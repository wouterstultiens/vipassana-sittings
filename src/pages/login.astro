---
// The gate serves this page to every request without a valid sign-in cookie.
// It inlines its CSS and its script, so it needs no file from `/_astro/`, which
// the gate never serves. The site is static, so the script shows the failure
// message in the browser.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Sign in &middot; Vipassana Sittings</title>
    <style is:inline>
      :root {
        color-scheme: light;
      }

      body {
        margin: 0;
        min-height: 100svh;
        display: grid;
        place-items: center;
        padding: 1.5rem;
        background: #f4f1ea;
        color: #241f1a;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      }

      main {
        width: 100%;
        max-width: 22rem;
      }

      h1 {
        margin: 0 0 0.25rem;
        font-size: 1.375rem;
        font-weight: 600;
      }

      p.lead {
        margin: 0 0 1.5rem;
        color: #6b6157;
        font-size: 0.9375rem;
      }

      form {
        display: grid;
        gap: 0.875rem;
      }

      label {
        display: grid;
        gap: 0.375rem;
        font-size: 0.8125rem;
        font-weight: 500;
        color: #4a423a;
      }

      input {
        font: inherit;
        padding: 0.5rem 0.6875rem;
        border: 1px solid #d6cfc2;
        border-radius: 0.5rem;
        background: #fffdf9;
        color: inherit;
      }

      input:focus-visible {
        outline: 2px solid #8a6d3b;
        outline-offset: 1px;
        border-color: #8a6d3b;
      }

      button {
        font: inherit;
        font-weight: 600;
        margin-top: 0.25rem;
        padding: 0.5625rem;
        border: 0;
        border-radius: 0.5rem;
        background: #3c342b;
        color: #f8f5ef;
        cursor: pointer;
      }

      button:hover {
        background: #241f1a;
      }

      p.error {
        margin: 0;
        padding: 0.5rem 0.6875rem;
        border-radius: 0.5rem;
        background: #f6e3df;
        color: #7d2b1c;
        font-size: 0.875rem;
      }

      [hidden] {
        display: none;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Vipassana Sittings</h1>
      <p class="lead">A calendar of virtual group sittings for old students.</p>
      <form method="post" action="/login">
        <p class="error" id="error" hidden>The user or the password is wrong.</p>
        <label>
          Old student
          <input type="text" name="user" autocomplete="username" autocapitalize="none" autofocus required />
        </label>
        <label>
          Password
          <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <button type="submit">Sign in</button>
      </form>
    </main>
    <script is:inline>
      if (new URLSearchParams(location.search).has("failed")) {
        document.getElementById("error").hidden = false;
      }
    </script>
  </body>
</html>
