{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": { "@/*": ["./src/*"] },
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["src", "pipeline", ".astro/types.d.ts"],
  "exclude": ["dist"]
}
